{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/invoices/[id]",
      "regex": "^/api/invoices/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/invoices/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/projects/[id]",
      "regex": "^/api/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/projects/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api",
      "regex": "^/api(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api(?:/)?$"
    },
    {
      "page": "/api/backup",
      "regex": "^/api/backup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/backup(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/api/import",
      "regex": "^/api/import(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/import(?:/)?$"
    },
    {
      "page": "/api/import/batch",
      "regex": "^/api/import/batch(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/import/batch(?:/)?$"
    },
    {
      "page": "/api/import/confirm",
      "regex": "^/api/import/confirm(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/import/confirm(?:/)?$"
    },
    {
      "page": "/api/import/existing",
      "regex": "^/api/import/existing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/import/existing(?:/)?$"
    },
    {
      "page": "/api/init",
      "regex": "^/api/init(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/init(?:/)?$"
    },
    {
      "page": "/api/invoices",
      "regex": "^/api/invoices(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/invoices(?:/)?$"
    },
    {
      "page": "/api/invoices/export",
      "regex": "^/api/invoices/export(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/invoices/export(?:/)?$"
    },
    {
      "page": "/api/invoices/export-inject",
      "regex": "^/api/invoices/export\\-inject(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/invoices/export\\-inject(?:/)?$"
    },
    {
      "page": "/api/logs",
      "regex": "^/api/logs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/logs(?:/)?$"
    },
    {
      "page": "/api/open-excel",
      "regex": "^/api/open\\-excel(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/open\\-excel(?:/)?$"
    },
    {
      "page": "/api/projects",
      "regex": "^/api/projects(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/projects(?:/)?$"
    },
    {
      "page": "/api/shutdown",
      "regex": "^/api/shutdown(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/shutdown(?:/)?$"
    },
    {
      "page": "/api/stats",
      "regex": "^/api/stats(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/stats(?:/)?$"
    },
    {
      "page": "/api/stats/advanced",
      "regex": "^/api/stats/advanced(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/stats/advanced(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}